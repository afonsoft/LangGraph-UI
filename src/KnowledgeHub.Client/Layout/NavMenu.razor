<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Knowledge</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sources">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Fontes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mcp-monitor">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Monitor MCP
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="approvals">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Aprovações
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="chat">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Chat
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="playground">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Playground
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="api-keys">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> API Keys
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" role="button" @onclick="LogoutAsync">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sair
            </a>
        </div>
    </nav>
</div>

@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        AuthState.Invalidate();
        Nav.NavigateTo("/login");
    }
}
