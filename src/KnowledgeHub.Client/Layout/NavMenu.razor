<div class="sidebar-header">
    <a class="navbar-brand" href="">Knowledge</a>
    <button class="sidebar-collapse-btn d-none d-md-inline-flex" type="button"
            title="@(Collapsed ? "Expandir menu" : "Recolher menu")"
            aria-label="@(Collapsed ? "Expandir menu" : "Recolher menu")"
            aria-expanded="@(!Collapsed)"
            @onclick="OnToggleCollapse">
        <i class="fa-solid @(Collapsed ? "fa-angles-right" : "fa-angles-left")" aria-hidden="true"></i>
    </button>
</div>

<nav class="nav-scrollable">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-label="Home" @onclick="OnItemClick">
            <i class="fa-solid fa-house" aria-hidden="true"></i><span class="nav-label">Home</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="sources" data-label="Fontes" @onclick="OnItemClick">
            <i class="fa-solid fa-database" aria-hidden="true"></i><span class="nav-label">Fontes</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="mcp-monitor" data-label="Monitor MCP" @onclick="OnItemClick">
            <i class="fa-solid fa-server" aria-hidden="true"></i><span class="nav-label">Monitor MCP</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="approvals" data-label="Aprovações" @onclick="OnItemClick">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i><span class="nav-label">Aprovações</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="chat" data-label="Chat" @onclick="OnItemClick">
            <i class="fa-solid fa-comments" aria-hidden="true"></i><span class="nav-label">Chat</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="playground" data-label="Playground" @onclick="OnItemClick">
            <i class="fa-solid fa-flask" aria-hidden="true"></i><span class="nav-label">Playground</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="api-keys" data-label="API Keys" @onclick="OnItemClick">
            <i class="fa-solid fa-key" aria-hidden="true"></i><span class="nav-label">API Keys</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="settings" data-label="Settings" @onclick="OnItemClick">
            <i class="fa-solid fa-gear" aria-hidden="true"></i><span class="nav-label">Settings</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <a class="nav-link" role="button" data-label="Sair" @onclick="LogoutAsync">
            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span class="nav-label">Sair</span>
        </a>
    </div>
</nav>

@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback OnNavItemClicked { get; set; }

    private async Task OnItemClick()
    {
        if (OnNavItemClicked.HasDelegate)
            await OnNavItemClicked.InvokeAsync();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        AuthState.Invalidate();
        Nav.NavigateTo("/login");
    }
}
