@page "/playground"
@using System.Text.Json
@using KnowledgeHub.Shared.Contracts
@inject ToolsApiClient Tools
@inject ToastService Toast

<PageTitle>Playground — KnowledgeHub</PageTitle>

<h3 class="mb-3">Playground de tools MCP</h3>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <Card>
            <HeaderTemplate>
                <div class="d-flex justify-content-between align-items-center">
                    <span>Tools (@(_tools?.Count ?? 0))</span>
                    <Button Size="Size.Small" Icon="fa-solid fa-rotate" IsAsync="true"
                            OnClick="LoadToolsAsync" IsDisabled="_loading" />
                </div>
            </HeaderTemplate>
            <BodyTemplate>
                @if (_tools is null)
                {
                    <div class="text-muted">Carregando catálogo…</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var t in _tools)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(t.Name == _selected?.Name ? "active" : "")"
                                    @onclick="() => SelectTool(t)">
                                <code>@t.Name</code>
                                @if (!t.ReadOnly)
                                {
                                    <Badge Color="Color.Warning">write</Badge>
                                }
                            </button>
                        }
                    </div>
                }
            </BodyTemplate>
        </Card>
    </div>

    <div class="col-12 col-lg-8">
        @if (_selected is null)
        {
            <div class="text-center text-muted py-5">
                <div class="fs-1 mb-2"><i class="fa-solid fa-arrow-left"></i></div>
                Selecione uma tool à esquerda para testá-la.
            </div>
        }
        else
        {
            <Card class="mb-3">
                <HeaderTemplate>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><code>@_selected.Name</code></span>
                        @if (_selected.ReadOnly)
                        {
                            <Badge Color="Color.Success">read-only</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Warning">escrita real</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <p class="text-muted">@_selected.Description</p>

                    @foreach (var field in _fields)
                    {
                        <div class="mb-2">
                            <label class="form-label">
                                <code>@field.Name</code>
                                @if (field.Required)
                                {
                                    <span class="text-danger">*</span>
                                }
                                <small class="text-muted ms-1">@field.Type@(field.Description is not null ? $" — {field.Description}" : "")</small>
                            </label>
                            @if (field.Simple)
                            {
                                <BootstrapInput @bind-Value="field.TextValue" PlaceHolder="@field.Type" />
                            }
                            else
                            {
                                <Textarea @bind-Value="field.TextValue" rows="3"
                                          placeholder="@(field.Type == "array" ? "[\"a\", \"b\"]" : "{ }")" />
                            }
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2 mt-3">
                        <Button Color="Color.Primary" Icon="fa-solid fa-play" Text="Executar"
                                IsAsync="true" OnClick="RunToolAsync" IsDisabled="_running" />
                        @if (_elapsedMs is not null)
                        {
                            <span class="text-muted">@_elapsedMs.Value.ToString("F0") ms</span>
                        }
                    </div>
                </BodyTemplate>
            </Card>

            @if (_result is not null)
            {
                <Card>
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Resultado</span>
                            <div>
                                @if (_isError)
                                {
                                    <Badge Color="Color.Danger">isError</Badge>
                                }
                                <Switch @bind-Value="_showRaw" DisplayText="JSON" ShowLabel="true" />
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_showRaw)
                        {
                            <pre class="border rounded p-3 bg-light mb-0" style="max-height: 480px; overflow: auto;">@_result.Value.ToString()</pre>
                        }
                        else if (_structuredAnswer is not null)
                        {
                            <div class="mb-2" style="white-space: pre-wrap;">@_structuredAnswer</div>
                            @if (_citations.Count > 0)
                            {
                                <div class="border-top pt-2 mt-2">
                                    <small class="text-muted d-block mb-1">Citações</small>
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var c in _citations)
                                        {
                                            <li>
                                                <code>[@c.Index]</code> @c.Title —
                                                <span class="text-muted">@c.Source</span>
                                                <small class="text-muted">(@c.Uri)</small>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else if (_texts.Count > 0)
                        {
                            @foreach (var text in _texts)
                            {
                                <pre class="mb-1 @( _isError ? "text-danger" : "")" style="white-space: pre-wrap;">@text</pre>
                            }
                        }
                        else
                        {
                            <pre class="border rounded p-3 bg-light mb-0" style="max-height: 480px; overflow: auto;">@_result.Value.ToString()</pre>
                        }
                    </BodyTemplate>
                </Card>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<ToolDescriptorDto>? _tools;
    private ToolDescriptorDto? _selected;
    private List<FieldModel> _fields = [];
    private bool _loading;
    private bool _running;
    private bool _showRaw;
    private bool _isError;
    private JsonElement? _result;
    private List<string> _texts = [];
    private string? _structuredAnswer;
    private List<CitationModel> _citations = [];
    private double? _elapsedMs;

    protected override async Task OnInitializedAsync() => await LoadToolsAsync();

    private async Task LoadToolsAsync()
    {
        _loading = true;
        try
        {
            _tools = (await Tools.ListAsync())?.Tools ?? [];
            if (_selected is null)
                _selected = _tools.FirstOrDefault(t => t.Name == "search_knowledge") ?? _tools.FirstOrDefault();
            if (_selected is not null)
                BuildFields();
        }
        catch (Exception ex)
        {
            await Toast.Error("Falha ao listar tools", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectTool(ToolDescriptorDto tool)
    {
        _selected = tool;
        _result = null;
        _elapsedMs = null;
        BuildFields();
    }

    private void BuildFields()
    {
        _fields = [];
        if (_selected is null) return;
        var schema = _selected.InputSchema;
        if (schema.ValueKind != JsonValueKind.Object ||
            !schema.TryGetProperty("properties", out var props))
            return;

        var required = schema.TryGetProperty("required", out var req)
            ? req.EnumerateArray().Select(e => e.GetString()!).ToHashSet()
            : [];

        foreach (var p in props.EnumerateObject())
        {
            var type = p.Value.TryGetProperty("type", out var t) && t.ValueKind == JsonValueKind.String
                ? t.GetString()!
                : p.Value.TryGetProperty("anyOf", out _) ? "anyOf" : "object";
            var description = p.Value.TryGetProperty("description", out var d) ? d.GetString() : null;
            _fields.Add(new FieldModel
            {
                Name = p.Name,
                Type = type,
                Description = description,
                Required = required.Contains(p.Name),
                Simple = type is "string" or "integer" or "number" or "boolean"
            });
        }
    }

    private async Task RunToolAsync()
    {
        if (_selected is null) return;

        var missing = _fields.Where(f => f.Required && string.IsNullOrWhiteSpace(f.TextValue)).Select(f => f.Name).ToList();
        if (missing.Count > 0)
        {
            await Toast.Error("Campos obrigatórios", string.Join(", ", missing));
            return;
        }

        // Assemble the arguments JSON from the form fields.
        var args = new Dictionary<string, JsonElement>();
        foreach (var f in _fields.Where(f => !string.IsNullOrWhiteSpace(f.TextValue)))
        {
            try
            {
                args[f.Name] = f.Type switch
                {
                    "integer" or "number" => JsonSerializer.SerializeToElement(double.Parse(f.TextValue!)),
                    "boolean" => JsonSerializer.SerializeToElement(bool.Parse(f.TextValue!)),
                    "string" => JsonSerializer.SerializeToElement(f.TextValue),
                    _ => JsonDocument.Parse(f.TextValue!).RootElement.Clone()
                };
            }
            catch
            {
                await Toast.Error($"Valor inválido em '{f.Name}'", $"esperado {f.Type}");
                return;
            }
        }

        _running = true;
        _result = null;
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var result = await Tools.CallAsync(_selected.Name, JsonSerializer.Serialize(args));
            _result = result;
            _isError = result.TryGetProperty("isError", out var e) && e.GetBoolean();
            _texts = result.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.Array
                ? content.EnumerateArray()
                    .Where(c => c.TryGetProperty("type", out var t) && t.GetString() == "text")
                    .Select(c => c.GetProperty("text").GetString() ?? "")
                    .ToList()
                : [];
            (_structuredAnswer, _citations) = ParseStructured(result);
            _elapsedMs = sw.Elapsed.TotalMilliseconds;
        }
        catch (Exception ex)
        {
            await Toast.Error("Chamada falhou", ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    private static (string? Answer, List<CitationModel> Citations) ParseStructured(JsonElement result)
    {
        if (!result.TryGetProperty("structuredContent", out var sc) ||
            !sc.TryGetProperty("answer", out var a) || a.ValueKind != JsonValueKind.String)
            return (null, []);

        var citations = new List<CitationModel>();
        if (sc.TryGetProperty("citations", out var cs) && cs.ValueKind == JsonValueKind.Array)
        {
            foreach (var c in cs.EnumerateArray())
            {
                citations.Add(new CitationModel
                {
                    Index = c.TryGetProperty("index", out var i) ? i.GetInt32() : 0,
                    Source = c.TryGetProperty("source", out var s) ? s.GetString() ?? "" : "",
                    Title = c.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "",
                    Uri = c.TryGetProperty("uri", out var u) ? u.GetString() ?? "" : ""
                });
            }
        }
        return (a.GetString(), citations);
    }

    private sealed class CitationModel
    {
        public int Index { get; init; }
        public string Source { get; init; } = "";
        public string Title { get; init; } = "";
        public string Uri { get; init; } = "";
    }

    private sealed class FieldModel
    {
        public required string Name { get; init; }
        public required string Type { get; init; }
        public string? Description { get; init; }
        public bool Required { get; init; }
        public bool Simple { get; init; }
        public string? TextValue { get; set; }
    }
}
