@page "/settings"
@attribute [Authorize]
@inject SettingsApiClient Api
@inject ToastService Toast

<PageTitle>Settings — Knowledge</PageTitle>

<h3 class="mb-3">Settings</h3>

<h5 class="mb-2 text-muted">Chat (LLM)</h5>
<p class="text-muted">
    Provider OpenAI-compatible usado na síntese de respostas e no loop do agente.
    O endpoint vai sem <code>/v1</code> — o cliente adiciona
    <code>/v1/chat/completions</code>. A API key é criptografada em repouso e
    nunca retorna à interface — só os 4 últimos caracteres são exibidos.
</p>

@if (_chat is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração de chat…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Provider OpenAI-compatible</span>
                        @if (_chat.Source == "store")
                        {
                            <Badge Color="Color.Success">configurada</Badge>
                        }
                        else if (_chat.Source == "env")
                        {
                            <Badge Color="Color.Info">ambiente</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Secondary">não configurada</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    @if (_chat.Source == "env")
                    {
                        <small class="text-muted d-block mb-2">
                            Usando a configuração do ambiente — salve para sobrepor via interface.
                        </small>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-7">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_chatForm.Endpoint"
                                   placeholder="https://api.exemplo.com" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Model</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_chatForm.Model"
                                   placeholder="nome do modelo" autocomplete="off" />
                        </div>
                    </div>

                    @if (_chat.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">Key ativa (@_chat.ApiKeySource):</small>
                            <code class="ms-1">@_chat.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        @(_chat.HasApiKey ? "Substituir API key" : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_chatForm.ApiKey"
                           placeholder="@(_chat.HasApiKey ? "deixe em branco para manter" : "sk-…")"
                           autocomplete="off" />

                    <div class="d-flex gap-2 flex-wrap">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_chatForm.Saving"
                                OnClick="SaveChatAsync" />
                        <Button Color="Color.Secondary" Icon="fa-solid fa-plug" Text="Testar conexão"
                                IsAsync="true" IsDisabled="_chatForm.Testing"
                                OnClick="TestChatAsync" />
                        @if (_chat.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="Remover key" Title="Remover key"
                                              Content="A key salva será removida; a env var (se houver) volta a valer."
                                              OnConfirm="RemoveChatKeyAsync" />
                        }
                        @if (_chat.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva (endpoint, model e key) será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearChatAsync" />
                        }
                    </div>

                    @if (_chatForm.TestResult is { } test)
                    {
                        <div class="alert @(test.Ok ? "alert-success" : "alert-danger") mt-3 mb-0 py-2">
                            @if (test.Ok)
                            {
                                <span>
                                    Conexão OK em @($"{test.LatencyMs:F0}") ms.@if (test.ModelListed == true)
                                    {<text> Modelo encontrado na lista do provider.</text>}
                                    else if (test.ModelListed == false)
                                    {<text> O modelo informado <strong>não</strong> consta na lista do provider.</text>}
                                </span>
                            }
                            else
                            {
                                <span>Falha na conexão: @test.Detail</span>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
    </div>
}

<h5 class="mb-2 text-muted">Knowledge Graph (GraphRAG)</h5>
<p class="text-muted">
    Extrai entidades e relações dos chunks indexados e expõe as tools
    <code>find_dependencies</code>, <code>find_dependents</code>, <code>find_path</code>
    e <code>analyze_impact</code> no catálogo MCP. A extração também exige
    <code>"graph": true</code> na configuração de cada source.
</p>

@if (_graph is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração do grafo…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Extração e travessia do grafo</span>
                        @if (_graph.Source == "store")
                        {
                            <Badge Color="Color.Success">configurada</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Info">ambiente</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-12 col-md-6">
                            <Switch @bind-Value="_graphForm.Enabled"
                                    DisplayText="Ativar GraphRAG" ShowLabel="true" />
                            <small class="text-muted d-block mt-1">
                                Expõe as tools no catálogo MCP e roda a extração na ingestão.
                            </small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max chunks por sync</label>
                            <input type="number" class="form-control font-monospace" min="1" max="10000"
                                   @bind="_graphForm.MaxChunksPerSync" />
                            <small class="text-muted">Budget de extração LLM por sync (1–10000)</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max chars por chunk</label>
                            <input type="number" class="form-control font-monospace" min="200" max="50000"
                                   @bind="_graphForm.MaxChunkChars" />
                            <small class="text-muted">Truncamento no prompt de extração (200–50000)</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max resultados</label>
                            <input type="number" class="form-control font-monospace" min="10" max="10000"
                                   @bind="_graphForm.MaxResults" />
                            <small class="text-muted">Teto de arestas por travessia (10–10000)</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_graphForm.Saving"
                                OnClick="SaveGraphAsync" />
                        @if (_graph.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearGraphAsync" />
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}

<h5 class="mb-2 text-muted">Integrações</h5>
<p class="text-muted">
    API keys de serviços upstream consumidos pelo MCP interno. As chaves são
    criptografadas em repouso e nunca retornam à interface — só os 4 últimos
    caracteres são exibidos.
</p>

@if (_integrations is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando integrações…</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in _integrations)
        {
            var state = _forms[item.Provider];
            <div class="col-12 col-lg-6">
                <Card>
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@item.DisplayName</span>
                            @if (item.HasKey)
                            {
                                <Badge Color="Color.Success">configurada</Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Secondary">sem key</Badge>
                            }
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (item.Note is not null)
                        {
                            <p class="text-muted mb-2">@item.Note</p>
                        }

                        @if (item.HasKey)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Key ativa (@item.Source):</small>
                                <code class="ms-1">@item.KeyHint</code>
                            </div>
                        }

                        <label class="form-label">
                            @(item.HasKey ? "Substituir API key" : "API key")
                        </label>
                        <div class="input-group">
                            <input type="password" class="form-control font-monospace"
                                   @bind="state.Input"
                                   placeholder="@(item.Provider == "firecrawl" ? "fc-…" : item.Provider == "tavily" ? "tvly-…" : item.Provider == "context7" ? "ctx7sk-…" : "API key")"
                                   autocomplete="off" />
                            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                    IsAsync="true" IsDisabled="state.Saving"
                                    OnClick="() => SaveAsync(item)" />
                            @if (item.Source == "store")
                            {
                                <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                                  Text="Remover" Title="Remover key"
                                                  Content="A key salva será removida; a env var (se houver) volta a valer."
                                                  OnConfirm="() => RemoveAsync(item)" />
                            }
                        </div>
                        @if (item.Provider == "deepwiki")
                        {
                            <small class="text-muted d-block mt-2">
                                Sem key o DeepWiki usa o endpoint público (<code>mcp.deepwiki.com/mcp</code>);
                                com key passa a usar o privado (<code>mcp.devin.ai/mcp</code>).
                            </small>
                        }
                        @if (item.Provider == "firecrawl" && !item.HasKey)
                        {
                            <small class="text-muted d-block mt-2">
                                Sem key, as tools <code>firecrawl_*</code> aparecem no catálogo mas
                                retornam erro orientando a configuração aqui.
                            </small>
                        }
                    </BodyTemplate>
                </Card>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<IntegrationSettingsDto>? _integrations;
    private readonly Dictionary<string, FormState> _forms = new();
    private ChatSettingsDto? _chat;
    private readonly ChatFormState _chatForm = new();
    private GraphSettingsDto? _graph;
    private readonly GraphFormState _graphForm = new();

    private sealed class FormState
    {
        public string Input { get; set; } = "";
        public bool Saving { get; set; }
    }

    private sealed class ChatFormState
    {
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public bool Saving { get; set; }
        public bool Testing { get; set; }
        public TestChatConnectionResponse? TestResult { get; set; }
    }

    private sealed class GraphFormState
    {
        public bool Enabled { get; set; }
        public int MaxChunksPerSync { get; set; }
        public int MaxChunkChars { get; set; }
        public int MaxResults { get; set; }
        public bool Saving { get; set; }
    }

    /// <summary>Inicializa a página carregando integrações e as configurações de chat e grafo.</summary>
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await ReloadChatAsync();
        await ReloadGraphAsync();
    }

    /// <summary>Recarrega a lista de integrações e garante o estado dos formulários.</summary>
    private async Task ReloadAsync()
    {
        try
        {
            _integrations = (await Api.ListIntegrationsAsync())?.Integrations ?? [];
            foreach (var i in _integrations)
                _forms.TryAdd(i.Provider, new FormState());
        }
        catch (Exception ex)
        {
            _integrations = [];
            await Toast.Error("Erro", $"Falha ao carregar integrações: {ex.Message}");
        }
    }

    /// <summary>Recarrega a configuração efetiva de chat e preenche o formulário do card.</summary>
    private async Task ReloadChatAsync()
    {
        try
        {
            _chat = await Api.GetChatAsync();
            _chatForm.Endpoint = _chat?.Endpoint ?? "";
            _chatForm.Model = _chat?.Model ?? "";
            _chatForm.TestResult = null;
        }
        catch (Exception ex)
        {
            _chat = null;
            await Toast.Error("Erro", $"Falha ao carregar configuração de chat: {ex.Message}");
        }
    }

    /// <summary>Valida e salva endpoint/model do chat; key em branco mantém a armazenada.</summary>
    private async Task SaveChatAsync()
    {
        if (string.IsNullOrWhiteSpace(_chatForm.Endpoint) || string.IsNullOrWhiteSpace(_chatForm.Model))
        {
            await Toast.Error("Campos obrigatórios", "Informe endpoint e model antes de salvar.");
            return;
        }

        _chatForm.Saving = true;
        try
        {
            var result = await Api.SaveChatAsync(
                _chatForm.Endpoint.Trim(), _chatForm.Model.Trim(),
                string.IsNullOrWhiteSpace(_chatForm.ApiKey) ? null : _chatForm.ApiKey.Trim());
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao salvar a configuração");
                return;
            }
            _chatForm.ApiKey = "";
            await Toast.Success("Salva", "Configuração de chat aplicada — já está em vigor.");
            await ReloadChatAsync();
        }
        finally
        {
            _chatForm.Saving = false;
        }
    }

    /// <summary>Executa o teste de conexão com os valores do formulário e exibe o resultado no card.</summary>
    private async Task TestChatAsync()
    {
        _chatForm.Testing = true;
        _chatForm.TestResult = null;
        try
        {
            var result = await Api.TestChatAsync(new TestChatConnectionRequest
            {
                Endpoint = _chatForm.Endpoint,
                Model = _chatForm.Model,
                ApiKey = _chatForm.ApiKey
            });
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao testar a conexão");
                return;
            }
            _chatForm.TestResult = result.Value;
            if (result.Value?.Ok == true)
                await Toast.Success("Conexão OK", $"Provider respondeu em {result.Value.LatencyMs:F0} ms.");
        }
        finally
        {
            _chatForm.Testing = false;
        }
    }

    /// <summary>Recarrega a configuração efetiva do grafo e preenche o formulário do card.</summary>
    private async Task ReloadGraphAsync()
    {
        try
        {
            _graph = await Api.GetGraphAsync();
            _graphForm.Enabled = _graph?.Enabled ?? false;
            _graphForm.MaxChunksPerSync = _graph?.MaxChunksPerSync ?? 200;
            _graphForm.MaxChunkChars = _graph?.MaxChunkChars ?? 2000;
            _graphForm.MaxResults = _graph?.MaxResults ?? 200;
        }
        catch (Exception ex)
        {
            _graph = null;
            await Toast.Error("Erro", $"Falha ao carregar configuração do grafo: {ex.Message}");
        }
    }

    /// <summary>Valida e salva a configuração do grafo; efeito imediato sem restart.</summary>
    private async Task SaveGraphAsync()
    {
        _graphForm.Saving = true;
        try
        {
            var result = await Api.SaveGraphAsync(new SaveGraphSettingsRequest
            {
                Enabled = _graphForm.Enabled,
                MaxChunksPerSync = _graphForm.MaxChunksPerSync,
                MaxChunkChars = _graphForm.MaxChunkChars,
                MaxResults = _graphForm.MaxResults
            });
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao salvar a configuração");
                return;
            }
            await Toast.Success("Salva", "Configuração do grafo aplicada — já está em vigor.");
            await ReloadGraphAsync();
        }
        finally
        {
            _graphForm.Saving = false;
        }
    }

    /// <summary>Apaga a configuração persistida do grafo, restaurando as variáveis de ambiente.</summary>
    private async Task ClearGraphAsync()
    {
        var result = await Api.ClearGraphAsync();
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error ?? "Falha ao restaurar o ambiente");
            return;
        }
        await Toast.Success("Restaurada", "Configuração do grafo voltou às variáveis de ambiente.");
        await ReloadGraphAsync();
    }

    /// <summary>Remove a key de chat armazenada e recarrega o card.</summary>
    private async Task RemoveChatKeyAsync()
    {
        var result = await Api.RemoveChatKeyAsync();
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error ?? "Falha ao remover a key");
            return;
        }
        await Toast.Success("Removida", "Key do chat removida.");
        await ReloadChatAsync();
    }

    /// <summary>Apaga a configuração persistida de chat, restaurando as variáveis de ambiente.</summary>
    private async Task ClearChatAsync()
    {
        var result = await Api.ClearChatAsync();
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error ?? "Falha ao restaurar o ambiente");
            return;
        }
        _chatForm.ApiKey = "";
        await Toast.Success("Restaurada", "Configuração de chat voltou às variáveis de ambiente.");
        await ReloadChatAsync();
    }

    /// <summary>Salva a API key digitada no formulário da integração.</summary>
    private async Task SaveAsync(IntegrationSettingsDto item)
    {
        var state = _forms[item.Provider];
        if (string.IsNullOrWhiteSpace(state.Input))
        {
            await Toast.Error("Key vazia", "Informe a API key antes de salvar.");
            return;
        }

        state.Saving = true;
        try
        {
            var result = await Api.SetKeyAsync(item.Provider, state.Input.Trim());
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao salvar a key");
                return;
            }
            state.Input = "";
            await Toast.Success("Salva", $"Key do {item.DisplayName} configurada.");
            await ReloadAsync();
        }
        finally
        {
            state.Saving = false;
        }
    }

    /// <summary>Remove a key armazenada da integração e recarrega a lista.</summary>
    private async Task RemoveAsync(IntegrationSettingsDto item)
    {
        var result = await Api.RemoveKeyAsync(item.Provider);
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error ?? "Falha ao remover a key");
            return;
        }
        await Toast.Success("Removida", $"Key do {item.DisplayName} removida.");
        await ReloadAsync();
    }
}
