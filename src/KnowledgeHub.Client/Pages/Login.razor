@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState

<PageTitle>Login — KnowledgeHub</PageTitle>

<div class="d-flex justify-content-center" style="padding-top: 12vh;">
    <div class="card" style="width: 360px;">
        <div class="card-body">
            <h4 class="card-title mb-1">KnowledgeHub</h4>
            <p class="text-muted mb-4">Entre para administrar a plataforma.</p>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label">Usuário</label>
                <input class="form-control" @bind="_username" @bind:event="oninput" autocomplete="username" />
            </div>
            <div class="mb-4">
                <label class="form-label">Senha</label>
                <input class="form-control" type="password" @bind="_password" @bind:event="oninput"
                       autocomplete="current-password" @onkeydown="OnEnter" />
            </div>

            <Button Color="Color.Primary" Text="Entrar" IsAsync="true" IsBlock="true"
                    OnClick="DoLogin" IsDisabled="_busy" />
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task OnEnter(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.LoginAsync(_username.Trim(), _password);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? "Falha no login";
                return;
            }

            AuthState.SetUser(new MeResponse(result.Value.Username, result.Value.MustChangePassword));
            Nav.NavigateTo(result.Value.MustChangePassword
                ? "/change-password"
                : "/" + (ReturnUrl ?? ""));
        }
        finally
        {
            _busy = false;
        }
    }
}
