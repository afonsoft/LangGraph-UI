%%{init: {'theme':'neutral'}}%%
flowchart LR
    subgraph Host["🖥️ Single host (container or bare binary)"]
        EXE["🚀 KnowledgeHub<br/>single-file binary or<br/>knowledgehub:latest image"]
        DB[("💾 ./data volume<br/>knowledgehub.db + uploads")]
        EXT["📂 %TMP%/.net extraction<br/>native libs (e_sqlite3, onnx)"]
        CFG["⚙️ appsettings.json + env vars<br/>(__ nesting) + .env<br/>runtime settings in SQLite"]
        EXE --> DB
        EXE -.->|self-extract| EXT
        CFG -.->|config| EXE
    end

    DEV["👨‍💻 docker compose build<br/>or dotnet publish -r linux-x64|win-x64|osx-arm64"] -->|produces| EXE

    subgraph Net["🌐 One port (:8080 container / :5000 dev)"]
        R1["/            → SPA + deep links"]
        R2["/api/*       → REST (auth + rate limits)"]
        R3["/mcp         → Streamable HTTP"]
        R4["/mcp/sse|msg → legacy SSE"]
        R5["/hubs/mcp    → SignalR"]
        R6["/metrics     → Prometheus (opt-in)"]
        R7["/healthz     → liveness probe"]
        R8["/framework-assets/{stem}/{ext} → _framework mirror<br/>(proxy-safe boot)"]
    end
    EXE --- Net

    classDef bin fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:darkgreen
    classDef data fill:#f5f5f5,stroke:#666666,stroke-width:2px,color:black
    classDef net fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:darkblue
    class EXE bin
    class DB,EXT,CFG data
    class R1,R2,R3,R4,R5,R6,R7,R8 net
